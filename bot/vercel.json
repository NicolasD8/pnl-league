{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": { "api/*.js": { "maxDuration": 60, "includeFiles": "assets/**" } },
  "rewrites": [
    { "source": "/go/:ref", "destination": "/api/go?ref=:ref" },
    { "source": "/go", "destination": "/api/go" },
    { "source": "/okx/:ref", "destination": "/api/okx?ref=:ref" },
    { "source": "/okx", "destination": "/api/okx" }
  ]
}
