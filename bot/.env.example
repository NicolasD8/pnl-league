# Copy these into Vercel > Project > Settings > Environment Variables. Never commit real values.
BOT_TOKEN=             # from @BotFather
BOT_USERNAME=PNLLeagueBot
WEBHOOK_SECRET=        # long random string you make up (letters, numbers, _ or -)
SHEET_URL=             # Apps Script web app URL ending in /exec
SHEET_SECRET=          # long random string, same as in Apps Script > Script properties
ADMIN_IDS=             # your Telegram user ID(s), comma separated. Send /whoami to the bot to see yours
ADMIN_CHAT_ID=         # optional: where questions go. Default = first ADMIN_IDS (your private chat with the bot)
REG_OPENS=2026-11-01T12:00:00+03:00
OKX_CAMPAIGN_URL=https://www.okx.com/campaigns/ce-community-trading-competition-phase-1
OKX_SIGNUP_URL=        # optional: OKX affiliate sign-up link
